{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Storefront products"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "compareAtPrice": {
      "type": "decimal",
      "required": false,
      "min": 0
    },
    "description": {
      "type": "text",
      "required": true
    },
    "category": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        },
        "content-type-builder": {
          "visible": false
        }
      }
    },
    "productCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "products",
      "required": true
    },
    "image": {
      "type": "text",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        },
        "content-type-builder": {
          "visible": false
        }
      }
    },
    "imageFile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "required": false
    },
    "gallery": {
      "type": "json",
      "required": false,
      "pluginOptions": {
        "content-manager": {
          "visible": false
        },
        "content-type-builder": {
          "visible": false
        }
      }
    },
    "galleryFiles": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"],
      "required": false
    },
    "ratingRate": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "ratingCount": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "stockQuantity": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    }
  }
}
